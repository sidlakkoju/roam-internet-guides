---
import QRCode from 'qrcode';
import { REFERRAL_URL, url } from '../lib/site';
interface Props { ctx?: { kind: string; name?: string } }
const { ctx = { kind: 'default' } } = Astro.props;
const qr = await QRCode.toString(REFERRAL_URL, { type: 'svg', margin: 1, width: 140 });
const ctxHead: Record<string, string> = {
  rv: 'Getting online in your RV? $100 back',
  boat: 'Getting online on your boat? $100 back',
  portable: 'Going portable? $100 back',
  state: `Rural internet in ${ctx.name ?? 'your state'}? $100 back`,
  default: 'Signing up for satellite internet? $100 back',
};
const contextual = ctxHead[ctx.kind] ?? ctxHead.default;
// Each element with class "x" is shown only for the variant ids listed in data-only (see CSS in Base.astro).
---
<aside class="ref" aria-label="Referral link">
  <p class="tag">Referral link</p>
  <h2 class="ref-h">
    <span class="x" data-only="plain">Get $100 back — open this referral link</span>
    <span class="x" data-only="money-back">Get $100 back after ~60 days of service</span>
    <span class="x" data-only="both">You get $100. I get $100.</span>
    <span class="x" data-only="no-catch">Same checkout price, plus $100 back later</span>
    <span class="x" data-only="steps">$100 back in three steps</span>
    <span class="x" data-only="return">$100 back, and you can still return it</span>
    <span class="x" data-only="checkout">Confirm “Referral Code Applied” — then $100 back</span>
    <span class="x" data-only="personal">I use it daily. If it helps, here's my link</span>
    <span class="x" data-only="contextual">{contextual}</span>
    <span class="x" data-only="twice sticky">Sign up with this link — $100 back later</span>
    <span class="x" data-only="minimal">$100 back with my referral link</span>
  </h2>
  <p class="note">Already planning to order? Using this link changes nothing about your price or plan. Look for “Referral Code Applied” before you pay, keep service active about 60 days, and $100 comes back to you as credit or cash.</p>
  <p class="x sub" data-only="no-catch">You pay exactly what the official site charges. The referral doesn't change your price.</p>
  <p class="x sub" data-only="return">The hardware can still be returned for a full refund within 30 days when bought directly on starlink.com (undamaged, per the official terms).</p>
  <p class="x sub" data-only="personal">— Siddharth</p>
  <p class="x sub" data-only="both">If you order through my link and keep service for about 60 days, we each get $100.</p>
  <p class="x sub" data-only="checkout">Stay in the same browser tab from open through pay. If you don’t see “Referral Code Applied,” go back and open the link again before checkout.</p>
  <ol class="x steps" data-only="steps">
    <li>Open the link in your phone's or computer's regular browser (not inside an app).</li>
    <li>Order on starlink.com in that same tab.</li>
    <li>Look for “Referral Code Applied” at checkout before paying.</li>
  </ol>
  <div class="ref-row">
    <a class="btn" data-ref-open href={REFERRAL_URL} rel="nofollow sponsored">
      <span class="x" data-only="plain steps return checkout contextual twice sticky">Open link</span>
      <span class="x" data-only="money-back no-catch">Get my $100 back</span>
      <span class="x" data-only="both personal">Use my link</span>
      <span class="x" data-only="minimal">Open referral link</span>
    </a>
    <button class="btn alt nm" type="button" data-copy={REFERRAL_URL}>Copy link</button>
    <span class="copied" hidden>Copied!</span>
  </div>
  <code class="ref-url nm">{REFERRAL_URL}</code>
  <details class="nm"><summary>Show QR code (scan on your phone)</summary><div class="qr" set:html={qr} /></details>
  <details class="x" data-only="minimal"><summary>How the referral works</summary>
    <ul class="ref-rules"><li>Order on starlink.com in the same browser tab that opened the link.</li><li>Look for “Referral Code Applied” at checkout.</li><li>Store-bought kits (e.g. Home Depot) don't count.</li></ul>
  </details>
  <ul class="ref-rules nm">
    <li>Order on starlink.com <strong>in the same browser tab that opened the link</strong>.</li>
    <li>Look for <strong>“Referral Code Applied”</strong> at checkout before paying.</li>
    <li>Store-bought kits (e.g. Home Depot or other retailers) don’t count.</li>
    <li>Reward: $100 each, after ~2 billing cycles (about 60 days) of active service.</li>
  </ul>
  <p class="disclosure"><strong>Disclosure:</strong> I work at SpaceX. Referrals earn me a reward and enter me in an internal SpaceX employee contest.</p>
</aside>
<script>
  const once = (window as any).__refInit; (window as any).__refInit = true;
  if (!once) {
    const track = (kind: string) => {
      if ((window as any).__noTrack) return;
      const v = document.documentElement.getAttribute('data-v') || 'none';
      const page = location.pathname.replace(/^\/|\/$/g, '') || 'home';
      const name = `${kind}/${page}/${v}`;
      (window as any).goatcounter?.count?.({ path: name, title: name, event: true });
    };
    const v = document.documentElement.getAttribute('data-v');
    const box = document.querySelector<HTMLElement>('aside.ref');
    if (box && v === 'twice') {
      const h2 = Array.from(document.querySelectorAll('main h2')).filter((h) => !box.contains(h))[1];
      const clone = box.cloneNode(true);
      if (h2) h2.before(clone);
      else document.querySelector('main')?.appendChild(clone);
    }
    if (v === 'sticky') {
      const bar = document.createElement('a');
      bar.className = 'sticky-bar'; bar.href = box?.querySelector<HTMLAnchorElement>('[data-ref-open]')?.href || '#';
      bar.rel = 'nofollow sponsored'; bar.setAttribute('data-ref-open', '');
      bar.textContent = 'Open link · $100 back after ~60 days';
      document.body.appendChild(bar);
    }
    document.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-ref-open]')) track('ref-open');
      const c = t.closest<HTMLButtonElement>('[data-copy]');
      if (c) {
        track('ref-copy');
        try { await navigator.clipboard.writeText(c.dataset.copy!); } catch { prompt('Copy this link:', c.dataset.copy!); return; }
        const s = c.parentElement!.querySelector<HTMLElement>('.copied'); if (s) { s.hidden = false; setTimeout(() => (s.hidden = true), 2000); }
      }
    });
  }
</script>
