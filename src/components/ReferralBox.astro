---
import QRCode from 'qrcode';
import { REFERRAL_URL } from '../lib/site';
const qr = await QRCode.toString(REFERRAL_URL, { type: 'svg', margin: 1, width: 140 });
---
<aside class="ref" aria-labelledby="ref-h">
  <h2 id="ref-h">Referral link ($100 off)</h2>
  <p>This is a <strong>referral link</strong>. If you order through it, you and the site owner each get a $100 credit after you keep service for about two billing cycles (~60 days).</p>
  <div class="ref-row">
    <a class="btn" href={REFERRAL_URL} rel="nofollow sponsored">Open referral link</a>
    <button class="btn alt" type="button" data-copy={REFERRAL_URL}>Copy link</button>
    <span class="copied" hidden>Copied!</span>
  </div>
  <code class="ref-url">{REFERRAL_URL}</code>
  <details><summary>Show QR code (scan on your phone)</summary><div class="qr" set:html={qr} /></details>
  <ul class="ref-rules">
    <li>Order on starlink.com <strong>in the same browser tab that opened the link</strong>.</li>
    <li>Look for <strong>“Referral Code Applied”</strong> at checkout before paying.</li>
    <li>Store-bought kits (e.g. Home Depot or other retailers) don’t count.</li>
    <li>Reward: $100 each, credited after ~2 billing cycles of active service.</li>
  </ul>
</aside>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy!); } catch { prompt('Copy this link:', b.dataset.copy!); return; }
    const s = b.parentElement!.querySelector<HTMLElement>('.copied'); if (s) { s.hidden = false; setTimeout(() => (s.hidden = true), 2000); }
  }));
</script>
