---
import InAppPrompt from '../components/InAppPrompt.astro';
import { SITE_NAME, url } from '../lib/site';
import variants from '../data/variants.json';
const varCss = variants.map((x) => `html[data-v="${x.id}"] .x[data-only~="${x.id}"]{display:revert}`).join('') + 'html[data-v="minimal"] .nm,html[data-v="minimal"] .note+.sub{display:none}';
interface Props { title: string; description: string; faq?: { q: string; a: string }[] }
const { title, description, faq = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ld = faq.length ? JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }) : null;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="article" />
  <link rel="sitemap" href={url('/sitemap-index.xml')} />
  {ld && <script type="application/ld+json" set:html={ld} />}
  <script is:inline define:vars={{ VARS: variants.filter((x) => x.enabled && x.weight > 0).map((x) => [x.id, x.weight]), ALL: variants.map((x) => x.id) }}>
    var f = new URLSearchParams(location.search).get('force'), v;
    if (f && ALL.indexOf(f) >= 0) { v = f; window.__noTrack = true; window.goatcounter = { no_onload: true }; }
    else {
      try { v = sessionStorage.getItem('rv'); } catch (e) {}
      if (!VARS.some(function (x) { return x[0] === v; })) {
        var tot = VARS.reduce(function (a, x) { return a + x[1]; }, 0), r = Math.random() * tot; v = VARS.length ? VARS[VARS.length - 1][0] : 'plain';
        for (var i = 0; i < VARS.length; i++) { r -= VARS[i][1]; if (r < 0) { v = VARS[i][0]; break; } }
        try { sessionStorage.setItem('rv', v); } catch (e) {}
      }
      window.goatcounter = { path: function (p) { return p + '?v=' + v; } };
    }
    document.documentElement.setAttribute('data-v', v);
  </script>
  <script is:inline data-goatcounter="https://roaminternet.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  <style is:global>
    :root{--fg:#1b1f24;--mut:#57606a;--ac:#0b5cad;--bg:#fff;--box:#f3f7fb}
    *{box-sizing:border-box}body{margin:0;font:17px/1.6 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:var(--fg);background:var(--bg)}
    header,main,footer{max-width:760px;margin:0 auto;padding:0 18px}header{padding-top:14px}header a{color:var(--fg);font-weight:700;text-decoration:none}
    nav{font-size:15px;display:flex;gap:14px;flex-wrap:wrap;margin-top:6px}nav a{font-weight:400;color:var(--ac)}
    a{color:var(--ac)}h1{line-height:1.25}table{border-collapse:collapse;width:100%}td,th{border:1px solid #d0d7de;padding:6px 8px;text-align:left}
    .ref{background:var(--box);border:2px solid var(--ac);border-radius:10px;padding:14px 16px;margin:18px 0}.ref h2{margin:0 0 6px;font-size:20px}.ref .tag{margin:0;font-size:13px;text-transform:uppercase;letter-spacing:.05em;color:var(--mut)}
    .ref-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.btn{background:var(--ac);color:#fff;border:0;border-radius:6px;padding:9px 14px;font-size:16px;text-decoration:none;cursor:pointer}
    .btn.alt{background:#fff;color:var(--ac);border:1px solid var(--ac)}.ref-url{display:block;font-size:13px;word-break:break-all;margin:8px 0;color:var(--mut)}
    .qr svg{width:140px;height:140px}.ref-rules{font-size:15px;margin:8px 0 0}.disclosure{font-size:14px;margin:8px 0 0}
    .x{display:none}.note{margin:0 0 6px;font-size:14px}.sub{margin:0 0 8px;font-size:15px}.ref .tag{margin:0 0 2px}.steps{margin:6px 0 10px}.speed img{max-width:100%;height:auto}
    .sticky-bar{display:none}@media (max-width:700px){.sticky-bar{display:block;position:fixed;left:0;right:0;bottom:0;z-index:8;background:var(--ac);color:#fff;text-align:center;padding:12px;font-weight:600;text-decoration:none}body{padding-bottom:52px}}
    .inapp{position:sticky;top:0;z-index:9;background:#fff4ce;border-bottom:2px solid #d4a72c;padding:10px 40px 10px 14px;font-size:15px}
    .inapp button{position:absolute;right:8px;top:6px;background:none;border:0;font-size:22px;cursor:pointer}
    footer{color:var(--mut);font-size:14px;margin-top:40px;padding-bottom:30px;border-top:1px solid #d0d7de}
  </style>
  <style set:html={varCss}></style>
</head>
<body>
  <InAppPrompt />
  <header><a href={url('/')}>{SITE_NAME}</a>
    <nav><a href={url('/guides/rv/')}>RV</a><a href={url('/guides/boat/')}>Boats</a><a href={url('/guides/portable/')}>Mini & portable</a><a href={url('/states/')}>Rural by state</a><a href={url('/faq/')}>FAQ</a></nav>
  </header>
  <main><slot /></main>
  <footer><p><strong>Disclosure:</strong> I work at SpaceX. Referrals earn me a reward and enter me in an internal SpaceX employee contest.</p><p>Independent guide; not affiliated with or endorsed by SpaceX or Starlink. Links in the referral box are personal referral links. Prices and plans change, so always confirm on the official site. No cookies and no ads; we use cookieless, privacy-friendly GoatCounter for aggregate visit counts.</p></footer>
</body>
</html>
