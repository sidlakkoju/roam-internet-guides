---
import Base from '../layouts/Base.astro';
import ReferralBox from '../components/ReferralBox.astro';
const faq = [
  { q: 'How does the referral link work?', a: 'Open the referral link and place an eligible order on the official site in the same browser tab that opened the link. Look for “Referral Code Applied” before paying. For the $100 credit offer described here, you and the referrer each receive a $100 credit after about two billing cycles of active service.' },
  { q: 'Why should I finish ordering in the same tab?', a: 'The referral needs to remain attached to your checkout. Complete the order in the same browser tab that opened the link, and verify “Referral Code Applied” before payment. Starting a separate shopping session can leave you without the referral confirmation.' },
  { q: 'What should I check before paying?', a: 'Look for “Referral Code Applied” at checkout, then review the selected kit, plan, delivery details and final total. Save the order confirmation and referral details so you have a record if you need support later.' },
  { q: 'What if the referral confirmation is missing?', a: 'Do not assume the credit will be added later. Open the referral link again, continue checkout in that same tab and look for “Referral Code Applied”. If it still does not appear, check the official offer terms or contact support before paying.' },
  { q: 'Do kits bought from a store qualify?', a: 'No. Store-bought kits, including kits from Home Depot or other retailers, do not count for this referral offer. Order directly through the referral link on the official site rather than buying a retail kit and expecting activation to earn the credit.' },
  { q: 'How much credit does each person receive?', a: 'The offer described on this site gives the new customer and the referrer $100 each in credit after roughly two billing cycles of active service. Check the offer shown at checkout for your country and selected subscription; eligibility and terms can vary.' },
  { q: 'When should I expect the credit?', a: 'Allow about two billing cycles of active service, roughly 60 days. It is not an immediate hardware discount. Review your account billing details and upcoming invoices for the credit, and use support if it has not appeared after the expected period.' },
  { q: 'Can I add the referral after placing my order?', a: 'Do not rely on a referral being added retroactively. Apply the link before ordering and confirm “Referral Code Applied” before paying. If you have already ordered, ask official support about your specific order rather than placing a duplicate order.' },
  { q: 'Will cancelling or pausing service affect the reward?', a: 'The credit described here depends on about two billing cycles of active service. Cancelling or pausing before meeting the requirements may affect eligibility or timing. Read the offer terms and ask support before changing service if the reward matters to your decision.' },
  { q: 'How do I compare the total cost before ordering?', a: 'Prices vary, so check the official site for current kit costs, service charges, shipping, taxes and optional accessories. Budget for the initial charges without subtracting a future referral credit, and verify that the selected plan supports your intended travel or installation.' },
];
---
<Base title="Satellite Internet Referral FAQ: $100 Credit, Checkout & Timing" description="Answers about the satellite internet referral credit: how to apply it, when it pays, and what doesn't qualify." faq={faq}>
  <h1>Frequently asked questions</h1>
  <ReferralBox />
  {faq.map((f) => <><h2>{f.q}</h2><p>{f.a}</p></>)}
</Base>
